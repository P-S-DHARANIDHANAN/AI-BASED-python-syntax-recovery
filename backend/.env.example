# ---------------------------------------------------------------------------
# Parsely configuration
# ---------------------------------------------------------------------------
# 1. Copy this file to ".env"  (same folder, exactly that name)
# 2. Paste your Gemini API key below (get one free at https://aistudio.google.com/apikey)
# 3. Save. That's it — app.py reads it automatically on startup.
#
# If you leave the key blank, Parsely still runs: it falls back to the built-in
# rule-based explanations instead of AI-generated ones.
# ---------------------------------------------------------------------------

GEMINI_API_KEY=

# Optional. Default is gemini-2.5-flash. You can switch to another Gemini model
# your key has access to (e.g. gemini-2.5-pro, gemini-2.0-flash).
GEMINI_MODEL=gemini-2.5-flash

# Optional server settings
PORT=5000
FLASK_DEBUG=0
